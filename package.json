{
    "name": "s-kybound-github-io",
    "type": "module",
    "version": "0.0.7",
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "eslint": "eslint src",
        "format": "prettier --write \"src/**/*.{astro,js,ts}\"",
        "format:ci": "prettier --list-different \"src/**/*.{astro,js,ts}\"",
        "prepare": "husky",
        "dev": "astro dev",
        "start": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro"
    },
    "dependencies": {
        "@astrojs/sitemap": "^3.7.3",
        "astro": "^7.0.4"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-astro": "^1.7.0",
        "husky": "^9.1.7",
        "lint-staged": "^15.5.2",
        "prettier": "^3.9.4",
        "prettier-plugin-astro": "^0.14.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.62.1"
    },
    "lint-staged": {
        "src/**/*.{astro,js,ts}": [
            "eslint --fix",
            "prettier --write"
        ]
    }
}
